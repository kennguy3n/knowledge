# Knowledge stack — environment variables.
# Copy to `.env` and fill in secret values before running `make up`.

# ── Substrate (Rust) ─────────────────────────────────────────────────
# 64-hex-char master key for SQLCipher encryption. Generate with:
#   openssl rand -hex 32
KNOWLEDGE_MASTER_KEY=
# Active-passive HA (WS2). Default `disabled` runs a single standalone
# substrate. Set to `primary`/`standby`/`auto` and build the image with
# REPLICATION_NATS=1 to ship/replay WAL frames over NATS. See
# docs/operator/deployment-guide.md.
KNOWLEDGE_SUBSTRATE_ROLE=disabled
REPLICATION_NATS=0

# ── Gateway (Go) ─────────────────────────────────────────────────────
# Static bearer token for admin/service-to-service calls (optional).
KNOWLEDGE_API_KEY=
# HMAC secret for tenant JWT validation (optional — empty disables).
KNOWLEDGE_JWT_SECRET=
# Rate limiting.
KNOWLEDGE_RATE_IP_RPS=50
KNOWLEDGE_RATE_TENANT_RPS=200
KNOWLEDGE_RATE_BURST=100
# CORS allow-list (comma-separated origins; empty means "*").
KNOWLEDGE_CORS_ORIGINS=
# Default connector sync interval (Go duration, e.g. "15m").
KNOWLEDGE_SYNC_INTERVAL=15m
# Externally reachable base URL (used for OAuth callbacks).
KNOWLEDGE_PUBLIC_BASE_URL=http://localhost:8080

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_USER=knowledge
# REQUIRED — no default. `docker compose` refuses to start if unset.
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=knowledge

# ── NATS ─────────────────────────────────────────────────────────────
# (No credentials needed for default local dev setup.)

# ── MinIO ────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
# REQUIRED — no default. `docker compose` refuses to start if unset.
# Generate with: openssl rand -base64 24
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=knowledge

# ── LLama server ─────────────────────────────────────────────────────
# The llama-server image ships Bonsai-1.7B baked in, so no model file is
# required. Only used if you uncomment the optional `volumes:` override on
# the llama-server service to serve a DIFFERENT GGUF: this is the host
# directory containing your replacement bonsai-1.7b.gguf (mounted RO).
LLAMA_MODEL_DIR=./models

# ── Synthesis device tier ────────────────────────────────────────────
# Controls which inference adapters activate. `high` enables on-device
# SLM synthesis (needs 4GB+ RAM); `medium`/`low` disable it. The
# installer sets this based on your answer to the synthesis prompt.
KNOWLEDGE_SLM_DEVICE_TIER=high

# ── Managed-cloud synthesis (optional) ───────────────────────────────
# Point synthesis at an external OpenAI-compatible endpoint instead of
# the self-hosted llama-server. Leave URL empty to keep synthesis local.
# Examples: https://api.openai.com/v1, https://api.groq.com/openai/v1,
# http://localhost:11434/v1 (Ollama). See docs/operator/configuration.md.
KNOWLEDGE_MANAGED_INFERENCE_URL=
KNOWLEDGE_MANAGED_INFERENCE_KEY=
KNOWLEDGE_MANAGED_INFERENCE_MODEL=gpt-4o-mini

# ── Grafana ──────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
# REQUIRED — no default. `docker compose` refuses to start if unset.
# Generate with: openssl rand -base64 24
GF_ADMIN_PASSWORD=

# ── Port overrides (host-side) ───────────────────────────────────────
GATEWAY_PORT=8080
ADMIN_PORT=3001
UI_PORT=3002
POSTGRES_PORT=5432
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
LLAMA_PORT=8081
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
