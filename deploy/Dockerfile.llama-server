# Multi-stage build for the llama-server (PrismML fork serving
# Qwen3.5-2B Q4_K_M GGUF). Build time is ~15–30 min on a 4-core machine.
#
# The Qwen3.5-2B GGUF weights are baked directly into the image (see the
# `model-fetcher` stage below), so the container serves synthesis out of
# the box with no runtime download or bind-mount. Operators can still
# override the bundled model by bind-mounting a different GGUF over
# /models/slm.gguf (see docker-compose.yml and
# docs/operator/deployment-guide.md).
#
# ── builder ──────────────────────────────────────────────────────────
FROM ubuntu:22.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --branch prism --depth 1 \
    https://github.com/kennguy3n/llama.cpp.git .

RUN cmake -B build -DLLAMA_NATIVE=OFF -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --target llama-server -j"$(nproc)"

# `llama-server` is dynamically linked against the llama.cpp shared
# libraries (libllama.so, libggml*.so, libmtmd.so). The runtime stage
# below copies only the binary, so without also shipping these the
# container dies on start with
# `error while loading shared libraries: libmtmd.so.0`. Collect every
# produced `.so*` into a single dir (their exact location varies across
# llama.cpp revisions — build/bin, build/src, build/ggml/src — so a
# `find` is more robust than hard-coded paths) for the runtime stage.
RUN mkdir -p /deps \
    && find /src/build -name '*.so*' -type f -exec cp -av {} /deps/ \; \
    && ls -la /deps

# ── model-fetcher ────────────────────────────────────────────────────
# Download the Qwen3.5-2B Q4_K_M GGUF from a public HuggingFace artifact so
# the weights ship inside the image. Override the source with the MODEL_URL
# build-arg to bake a different GGUF at build time. The default points at
# the community bartowski/Qwen_Qwen3.5-2B-GGUF Q4_K_M artifact, and
# MODEL_SHA256 defaults to that file's digest so the download is verified
# out of the box. When overriding MODEL_URL, pass a matching MODEL_SHA256
# (or MODEL_SHA256="" to skip verification for a non-default mirror).
#
# Optional alternative models (opt-in; Qwen3.5 stays the default): to bake
# the legacy Bonsai-1.7B or the larger Bonsai-4B Q2_0 model into a
# server-side image instead, override both build-args. NOTE: the in-image
# path `/models/slm.gguf` is a FIXED MOUNT SLOT, not a content descriptor —
# an alternative image still serves from that path so the ENTRYPOINT and the
# runtime bind-mount override stay unchanged. The image tag (e.g. `:4b`) is
# what distinguishes the contents; the filename intentionally does not.
#
#   docker build -f deploy/Dockerfile.llama-server \
#     --build-arg MODEL_URL=https://huggingface.co/prism-ml/Ternary-Bonsai-4B-gguf/resolve/main/Ternary-Bonsai-4B-Q2_0.gguf \
#     --build-arg MODEL_SHA256=<pin-when-the-4B-artifact-is-published> \
#     -t knowledge/llama-server:4b .
#
# TODO(qwen35-release): pin the real MODEL_SHA256 for the Qwen3.5-2B Q4_K_M
# GGUF once the artifact is verified. On-device Low tier stays encoder-only
# regardless. See deploy/model-artifacts/README.md.
#
# NOTE: `--ctx-size` (the KV-cache pool; see the rationale below the runtime
# stage) defaults to 8192. A larger model has a larger per-token KV-cache
# footprint, so an operator baking a bigger image should re-evaluate it for
# their RAM/concurrency budget. It is tunable without editing this file via
# the `CTX_SIZE` arg/env: set it at build time (`--build-arg CTX_SIZE=4096`)
# or override per container at run time (`docker run -e CTX_SIZE=4096 …`).
FROM ubuntu:22.04 AS model-fetcher
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates && rm -rf /var/lib/apt/lists/*
ARG MODEL_URL=https://huggingface.co/bartowski/Qwen_Qwen3.5-2B-GGUF/resolve/main/Qwen_Qwen3.5-2B-Q4_K_M.gguf
ARG MODEL_SHA256=
RUN wget -q -O /slm.gguf "$MODEL_URL" \
    && if [ -n "$MODEL_SHA256" ]; then \
         echo "$MODEL_SHA256  /slm.gguf" | sha256sum -c -; \
       else \
         echo "MODEL_SHA256 not set; skipping model checksum verification"; \
       fi

# ── runtime ──────────────────────────────────────────────────────────
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /models

COPY --from=builder /src/build/bin/llama-server /usr/local/bin/llama-server
# Ship the llama.cpp shared libraries the binary links against and refresh
# the loader cache so `llama-server` can actually start (see the builder
# stage). Done as root before dropping privileges below.
COPY --from=builder /deps/ /usr/local/lib/
RUN ldconfig
# Bake the weights in. A runtime bind-mount over /models still wins, so
# operators can override the bundled model without rebuilding the image.
COPY --from=model-fetcher /slm.gguf /models/slm.gguf

RUN useradd --system --create-home --shell /usr/sbin/nologin llama
USER llama

EXPOSE 8081
# `--ctx-size` is the size of the KV-cache pool. `llama-server` auto-sets
# `--parallel 4` with a *unified* KV cache, so the pool is shared across
# four slots. A single `SynthSummary` request needs roughly
# `prompt_tokens + DEFAULT_N_PREDICT` cells (≈ 600 + 512 ≈ 1.1k for a
# typical multi-record business scope; the evidence window is capped at
# SYNTHESIS_EVIDENCE_WINDOW = 50 rows). At the old 2048 a single verbose
# scope already consumed ~55 % of the shared pool, so any leftover cached
# slot or a second concurrent synthesis tripped "failed to find free space
# in the KV cache" → HTTP 500 → gateway 502. Bonsai-1.7B trains at
# n_ctx = 32768, so 8192 is well within model capability and costs only a
# modest KV-cache bump (≈ 1 GB extra, vs. multi-GB headroom on a synthesis
# host). This gives synthesis real room; `SummaryBundle::from_slm_str`
# still salvages the rare scope that rambles past `n_predict`.
#
# `--ctx-size` is sourced from the CTX_SIZE arg/env (default 8192) so it can
# be tuned for a larger model (e.g. the opt-in Bonsai-4B image) without
# editing this file — see the build/run examples in the model-fetcher
# comment block above.
ARG CTX_SIZE=8192
ENV CTX_SIZE=${CTX_SIZE}
# Exec-form via `sh -c … exec` keeps llama-server as PID 1 (clean signal
# handling / no shell wrapper lingering) while still expanding ${CTX_SIZE};
# the trailing "$@" forwards any extra args appended to `docker run` straight
# through to llama-server. `$0` is set to a label for tidy error messages.
#
# CTX_SIZE is operator-supplied, so validate it fails closed: anything that
# is not a *positive* integer aborts with a clear message (exit 64 =
# EX_USAGE) instead of silently handing garbage to llama-server. Two guards:
#   1. empty or non-digit  -> reject (`''|*[!0-9]*`).
#   2. all-zero (`0`, `00`, …) -> reject. After guard 1 the value is
#      digits-only, so "contains no non-`0` digit" means it is numerically
#      zero; `--ctx-size 0` would allocate a zero KV-cache and silently
#      break every inference request, so it must fail closed too.
# `"${CTX_SIZE}"` is a plain parameter expansion (its value is never
# re-scanned for command substitution), so this is also belt-and-suspenders
# against shell metacharacters in the value.
ENTRYPOINT ["/bin/sh", "-c", \
    "case \"${CTX_SIZE}\" in ''|*[!0-9]*) echo \"CTX_SIZE must be a positive integer (got: '${CTX_SIZE}')\" >&2; exit 64;; esac; case \"${CTX_SIZE}\" in *[!0]*) : ;; *) echo \"CTX_SIZE must be a positive integer (got: '${CTX_SIZE}')\" >&2; exit 64;; esac; exec llama-server --model /models/slm.gguf --host 0.0.0.0 --port 8081 --ctx-size \"${CTX_SIZE}\" --n-gpu-layers 0 \"$@\"", \
    "llama-server"]
