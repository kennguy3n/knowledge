# ── Builder ──────────────────────────────────────────────────────
FROM golang:1.23 AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /knowledge-gateway ./cmd/server

# ── Runtime ──────────────────────────────────────────────────────
FROM gcr.io/distroless/base-debian12

COPY --from=builder /knowledge-gateway /knowledge-gateway

EXPOSE 8080
ENTRYPOINT ["/knowledge-gateway"]
