# ── Knowledge Platform Environment Variables ─────────────────────
# Copy this file to .env and fill in production values.

# Gateway
KNOWLEDGE_API_KEY=changeme

# PostgreSQL
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=knowledge
POSTGRES_DB=knowledge
DATABASE_URL=postgres://knowledge:knowledge@postgres:5432/knowledge?sslmode=disable

# NATS
NATS_URL=nats://nats:4222

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Substrate
KNOWLEDGE_MASTER_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
SUBSTRATE_LISTEN_ADDR=0.0.0.0:9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
