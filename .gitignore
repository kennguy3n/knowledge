# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Test artifacts
*.sqlite
*.sqlite-journal
*.sqlite3
*.db

# Local env
.env
.env.local

# Terraform (deploy/terraform/) — local init state and provider cache.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example

# Generated demo output (entire directory; regenerated by `cargo run -p demo`)
results/

# Node / N-API addon build artefacts (crates/napi/)
crates/napi/node_modules/
crates/napi/*.node

# Admin SPA (admin/) build + dependency artefacts.
admin/node_modules/
admin/dist/
admin/*.tsbuildinfo
# The auto-generated index.js / index.d.ts ARE tracked — they are
# part of the JS-facing API surface, and CI verifies they don't
# drift from the Rust-side bindings (see the `napi-build` job in
# .github/workflows/ci.yml).

# Model artifacts fetched by scripts/download-models.sh for native local /
# on-device dev (multi-GB GGUF / MLX / ONNX). The llama-server Docker image
# bakes the GGUF in at build time, so these are never committed.
deploy/models/

# UniFFI build outputs for iOS / Android (crates/ffi/)
# These are regenerated by `crates/ffi/scripts/build_ios.sh` and
# `crates/ffi/scripts/build_android.sh` (or via the corresponding
# Makefile targets) and consumed by the platform host repos as
# pre-built artefacts. They are NOT tracked in source — CI
# rebuilds them on every push, and the host repos pin published
# release artefacts.
crates/ffi/ios/
crates/ffi/ios-bindings/
crates/ffi/android/
