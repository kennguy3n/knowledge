{
  "version": 1,
  "provider": "github",
  "description": "GitHub lifecycle: OAuth2 authorization_code exchange, refresh_token grant, /repos/{repo}/issues full walk, incremental ?since= poll, issue-body + comments content assembly, and /repos/{repo}/hooks webhook registration. Issues webhook handled offline. Tokens are synthetic.",
  "interactions": [
    {
      "request": {
        "method": "POST",
        "url": "https://github.com/login/oauth/access_token"
      },
      "response": {
        "status": 200,
        "headers": [["content-type", "application/json"]],
        "body": {
          "text": "{\"access_token\":\"gho_github_access\",\"refresh_token\":\"ghr_rt_1\",\"expires_in\":28800,\"scope\":\"repo\",\"token_type\":\"bearer\"}"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://github.com/login/oauth/access_token"
      },
      "response": {
        "status": 200,
        "headers": [["content-type", "application/json"]],
        "body": {
          "text": "{\"access_token\":\"gho_github_refreshed\",\"refresh_token\":\"ghr_rt_2\",\"expires_in\":28800,\"scope\":\"repo\",\"token_type\":\"bearer\"}"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.test/github/repos/owner/acme/issues?state=all&sort=updated&direction=asc&per_page=100&page=1"
      },
      "response": {
        "status": 200,
        "headers": [["content-type", "application/json"]],
        "body": {
          "text": "[{\"number\":101,\"id\":900101,\"title\":\"Login fails on Safari\",\"state\":\"open\",\"created_at\":\"2023-11-10T08:00:00Z\",\"updated_at\":\"2023-11-14T22:13:20Z\",\"body\":\"Steps to reproduce...\",\"user\":{\"login\":\"octocat\"}}]"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.test/github/repos/owner/acme/issues?state=all&sort=updated&direction=asc&per_page=100&page=1&since=2023-11-14T22%3A13%3A20%2B00%3A00"
      },
      "response": {
        "status": 200,
        "headers": [["content-type", "application/json"]],
        "body": {
          "text": "[{\"number\":102,\"id\":900102,\"title\":\"Add dark mode\",\"state\":\"open\",\"created_at\":\"2023-11-15T00:00:00Z\",\"updated_at\":\"2023-11-15T00:00:00Z\",\"body\":\"Feature request\",\"user\":{\"login\":\"hubber\"}}]"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.test/github/repos/owner/acme/issues/101"
      },
      "response": {
        "status": 200,
        "headers": [["content-type", "application/json"]],
        "body": {
          "text": "{\"number\":101,\"id\":900101,\"title\":\"Login fails on Safari\",\"state\":\"open\",\"created_at\":\"2023-11-10T08:00:00Z\",\"updated_at\":\"2023-11-14T22:13:20Z\",\"body\":\"Steps to reproduce the login failure.\",\"user\":{\"login\":\"octocat\"}}"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.test/github/repos/owner/acme/issues/101/comments?per_page=100&page=1"
