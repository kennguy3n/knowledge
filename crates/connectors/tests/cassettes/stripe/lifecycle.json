{
  "version": 1,
  "provider": "stripe",
  "description": "Stripe Connect lifecycle: OAuth2 authorization_code exchange, refresh_token grant, initial customer walk, incremental /v1/events poll, and single-customer content fetch. Tokens are synthetic; no live secrets.",
  "interactions": [
    {
      "request": {
        "method": "POST",
        "url": "https://connect.stripe.com/oauth/token"
      },
      "response": {
        "status": 200,
        "headers": [["content-type", "application/json"]],
        "body": {
          "text": "{\"access_token\":\"sk_test_live_access\",\"refresh_token\":\"rt_stripe_1\",\"expires_in\":3600,\"scope\":\"read_only\",\"token_type\":\"bearer\",\"stripe_user_id\":\"acct_test\"}"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://connect.stripe.com/oauth/token"
      },
      "response": {
        "status": 200,
        "headers": [["content-type", "application/json"]],
        "body": {
          "text": "{\"access_token\":\"sk_test_refreshed_access\",\"refresh_token\":\"rt_stripe_2\",\"expires_in\":3600,\"scope\":\"read_only\",\"token_type\":\"bearer\"}"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.test/stripe/v1/customers?limit=50"
      },
      "response": {
        "status": 200,
        "headers": [["content-type", "application/json"]],
        "body": {
          "text": "{\"object\":\"list\",\"url\":\"/v1/customers\",\"has_more\":false,\"data\":[{\"id\":\"cus_001\",\"object\":\"customer\",\"name\":\"Acme Pte Ltd\",\"email\":\"ap@acme.example\",\"description\":\"SME tenant fixture\",\"created\":1700000000}]}"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.test/stripe/v1/events?limit=50&types[]=customer.created&types[]=customer.updated&types[]=customer.deleted&created[gte]=1700000000"
      },
      "response": {
        "status": 200,
        "headers": [["content-type", "application/json"]],
        "body": {
          "text": "{\"object\":\"list\",\"url\":\"/v1/events\",\"has_more\":false,\"data\":[{\"id\":\"evt_1\",\"object\":\"event\",\"type\":\"customer.updated\",\"created\":1700000500,\"data\":{\"object\":{\"id\":\"cus_001\",\"object\":\"customer\"}}}]}"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.test/stripe/v1/customers/cus_001"
      },
      "response": {
        "status": 200,
        "headers": [["content-type", "application/json"]],
        "body": {
          "text": "{\"id\":\"cus_001\",\"object\":\"customer\",\"name\":\"Acme Pte Ltd\",\"email\":\"ap@acme.example\",\"description\":\"Primary billing account for the Acme SME tenant.\",\"created\":1700000000}"
        }
      }
    }
  ]
}
